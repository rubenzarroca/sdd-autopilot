{
  "name": "sdd-autopilot-engine",
  "version": "1.0.0",
  "description": "SDD Autopilot MCP server engine",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "sdd-autopilot": "build/index.js"
  },
